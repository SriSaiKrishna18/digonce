# DigOnce — Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo login credentials (create a department user in Supabase Auth)
DEMO_DEPARTMENT_EMAIL=demo@digonce.dev
DEMO_DEPARTMENT_PASSWORD=demo-password-change-me

# Demo reset secret (any random string, prevents public reset)
DEMO_RESET_SECRET=change-me-to-a-random-string
