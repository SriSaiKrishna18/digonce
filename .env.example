# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo department login (create this user in Supabase Auth)
DEMO_DEPARTMENT_EMAIL=demo@digonce.dev
DEMO_DEPARTMENT_PASSWORD=your-demo-password

# Demo reset secret (prevents public abuse)
DEMO_RESET_SECRET=your-reset-secret

# Google OAuth (configured in Supabase Dashboard → Auth → Providers → Google)
# 1. Go to Google Cloud Console → APIs & Credentials → Create OAuth 2.0 Client ID
# 2. Set authorized redirect URI to: https://your-project.supabase.co/auth/v1/callback
# 3. Paste Client ID and Secret in Supabase Dashboard → Auth → Providers → Google
# No env vars needed here — Google OAuth is configured entirely in Supabase Dashboard
